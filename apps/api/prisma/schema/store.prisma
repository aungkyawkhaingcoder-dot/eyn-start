model Store {
  id             Int            @id @default(autoincrement())
  ownerId        Int
  owner          User           @relation(fields: [ownerId], references: [id])
  name           String         @db.VarChar(80)
  slug           String         @unique @db.VarChar(60)
  description    String         @default("") @db.VarChar(1000)
  currency       String         @default("MMK") @db.VarChar(3)
  published      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  products       Product[]
  legacyProducts StoreProduct[]
  orders         Order[]
  categories     Category[]
  tags           Tag[]
  logoUrl        String         @default("") @db.VarChar(2000)
  coverUrl       String         @default("") @db.VarChar(2000)
  storefrontConfig Json          @default("{}")
  theme          String         @default("eyn-light") @db.VarChar(30)

  @@index([ownerId])
}

model StoreProduct {
  id          Int      @id @default(autoincrement())
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(160)
  description String   @default("") @db.VarChar(3000)
  price       Decimal  @db.Decimal(12, 2)
  inventory   Int      @default(0)
  imageUrl    String   @default("") @db.VarChar(2000)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId, createdAt])
}
