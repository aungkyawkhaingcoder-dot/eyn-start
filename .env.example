NODE_ENV=development
APP_ENV=local
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=0
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/app
ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-refresh-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# JWT expiry, cookie maxAge and mobile expiresIn share these values.
# Restart all processes after changes. Existing JWT expiry does not change.

# Choose ONE strategy. Both need Redis. All PM2 processes must use the same values.
AUTH_REFRESH_STRATEGY=redis
# AUTH_REFRESH_STRATEGY=bullmq
REDIS_URL=redis://127.0.0.1:6379
AUTH_REFRESH_PREFIX=prisma7-auth

# Email delivery: use an address on your verified Resend domain.
EMAIL_PROVIDER=resend
EMAIL_FROM="EYN Store <onboarding@resend.dev>"
RESEND_API_KEY=
