# EXAMPLE ONLY. Copy to .env on this server and replace every placeholder.
NODE_ENV=production
APP_ENV=development
PORT=8080
CORS_ORIGINS=https://dev.yourdomain.com
# Suitable when frontend and API share the same parent domain over HTTPS.
COOKIE_SAME_SITE=lax
# Set to 1 only behind ONE trusted proxy with direct backend access blocked.
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://replace-user:replace-password@replace-host:5432/shop_development
ACCESS_TOKEN_SECRET=replace-with-unique-development-access-secret
REFRESH_TOKEN_SECRET=replace-with-unique-development-refresh-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REFRESH_STRATEGY=redis
REDIS_URL=redis://replace-private-redis-host:6379
AUTH_REFRESH_PREFIX=demo-shop-development
EMAIL_PROVIDER=resend
EMAIL_FROM="Demo Shop <noreply@replace-verified-domain.com>"
RESEND_API_KEY=

# Google Sign-In: configure separate OAuth clients for each environment.
# Web application client ID (one value); no client secret needed for ID-token exchange.
GOOGLE_WEB_CLIENT_ID=
# Comma-separated allowed native ID-token audiences / authorized-party client IDs.
# Leave empty until the mobile app's nonce-capable Google flow is configured.
GOOGLE_MOBILE_CLIENT_IDS=

# Google browser redirect login (secret stays on backend only)
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/google/redirect/callback
GOOGLE_FRONTEND_ORIGIN=https://app.example.com
